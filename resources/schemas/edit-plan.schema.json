{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-pvg.local/schemas/edit-plan.schema.json",
  "title": "AI-PVG HyperFrames edit plan",
  "type": "object",
  "required": [
    "version", "title", "language", "preset", "width", "height", "fps",
    "duration", "theme", "transition_family", "audio", "scenes", "beats", "ending"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "preset": { "enum": ["9:16", "16:9", "1:1"] },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "fps": { "type": "integer", "minimum": 1, "maximum": 120 },
    "duration": { "type": "number", "minimum": 3 },
    "theme": { "type": "string" },
    "transition_family": { "type": "string", "minLength": 1 },
    "audio": {
      "type": "object",
      "required": ["voice", "music", "target_lufs", "true_peak", "fade_out"],
      "properties": {
        "voice": { "type": "string" },
        "music": { "type": "string" },
        "target_lufs": { "const": -14 },
        "true_peak": { "type": "number", "maximum": -1 },
        "fade_out": { "type": "number", "minimum": 0.5 }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id", "purpose", "start", "duration", "narration", "narration_start",
          "headline", "headline_words", "visual", "camera", "transition_in",
          "caption_style", "sfx", "music_intensity", "beats"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^scene-[0-9]+$" },
          "purpose": { "enum": ["hook", "context", "evidence", "payoff", "cta"] },
          "start": { "type": "number", "minimum": 0 },
          "duration": { "type": "number", "minimum": 2, "maximum": 4.5 },
          "narration": { "type": "string", "minLength": 1 },
          "narration_start": { "type": "number", "minimum": 0 },
          "headline": { "type": "string", "minLength": 1 },
          "headline_words": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": ["text", "emphasis"],
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "emphasis": { "type": "boolean" }
              }
            }
          },
          "visual": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["asset", "generated"] },
              "path": { "type": "string" },
              "source": { "type": "string" },
              "attribution": { "type": "string" },
              "pattern": { "type": "string" },
              "palette": { "type": "array", "minItems": 2, "items": { "type": "string" } }
            },
            "if": { "properties": { "kind": { "const": "asset" } } },
            "then": { "required": ["path"] }
          },
          "camera": {
            "type": "object",
            "required": ["type", "intensity"],
            "properties": {
              "type": { "enum": ["push-in", "push-out", "pan-left", "pan-right", "drift-up", "parallax"] },
              "intensity": { "type": "number", "minimum": 0.2, "maximum": 2 }
            }
          },
          "transition_in": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["type", "family", "duration"],
                "properties": {
                  "type": { "type": "string" },
                  "family": { "type": "string" },
                  "duration": { "type": "number", "minimum": 0.2, "maximum": 0.8 }
                }
              }
            ]
          },
          "caption_style": { "enum": ["word-pop", "word-highlight", "line-reveal"] },
          "sfx": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["cue", "time", "gain"],
              "properties": {
                "cue": { "enum": ["whoosh", "hit", "riser"] },
                "time": { "type": "number", "minimum": 0 },
                "gain": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "music_intensity": { "type": "number", "minimum": 0.1, "maximum": 0.6 },
          "beats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["time", "kind"],
              "properties": {
                "time": { "type": "number", "minimum": 0 },
                "kind": { "enum": ["reveal", "camera", "caption", "transition", "data", "payoff"] }
              }
            }
          },
          "data_points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "value", "source"],
              "properties": {
                "label": { "type": "string" },
                "value": { "type": ["number", "string"] },
                "source": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["time", "kind"],
        "properties": {
          "time": { "type": "number", "minimum": 0 },
          "kind": { "enum": ["reveal", "camera", "caption", "transition", "data", "payoff"] }
        }
      }
    },
    "ending": {
      "type": "object",
      "required": ["payoff", "fade_out_video", "fade_out_audio"],
      "properties": {
        "payoff": { "type": "string" },
        "fade_out_video": { "type": "number", "minimum": 0.5 },
        "fade_out_audio": { "type": "number", "minimum": 0.5 }
      }
    }
  }
}
