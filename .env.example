APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
REMOTION_CHROME_EXECUTABLE=
FFMPEG_PATH=
FFPROBE_PATH=
REMOTION_PORT=3099
REMOTION_OUTPUT_DIR=public/videos
REMOTION_RENDER_TIMEOUT=600
REMOTION_REQUIRE_VERIFICATION=true

# Dynamic RSS categories — unknown tags create first-class categories;
# content-only detection must reach the minimum weighted score.
NEWS_DEFAULT_CATEGORY=Uncategorized
NEWS_CATEGORY_DETECTION_MIN_SCORE=2.0

# Automation control plane — disabled and dry-run by default.
AUTOMATION_ENABLED=false
AUTOMATION_DRY_RUN=true
AUTOMATION_QUEUE_HIGH=automation-high
AUTOMATION_QUEUE_MEDIA=media
AUTOMATION_QUEUE_DEFAULT=default
AUTOMATION_MONTHLY_BUDGET_MICROS=5000000
AUTOMATION_PER_RUN_BUDGET_MICROS=250000
AUTOMATION_PER_CALL_BUDGET_MICROS=50000
AUTOMATION_BUDGET_ALERT_PERCENT=80
AUTOMATION_AI_PROVIDER=ollama
AUTOMATION_AI_FALLBACK=ollama
AUTOMATION_TTS_PROVIDER=mock
AUTOMATION_DUAL_PUBLIC_PUBLISH=true
AUTOMATION_APPROVAL_TTL_HOURS=72
AUTOMATION_SYSTEM_USER_ID=
AUTOMATION_BREAKER_FAILURE_THRESHOLD=3
AUTOMATION_BREAKER_COOLDOWN_SECONDS=900
AUTOMATION_BREAKER_FAILURE_WINDOW_SECONDS=3600
AUTOMATION_STAGE_MAX_ATTEMPTS=3
AUTOMATION_TRIAGE_ENABLED=false
AUTOMATION_TRIAGE_FEATURE_FLAG=triage.news_scoring_enabled
AUTOMATION_TRIAGE_LANGUAGE=en
AUTOMATION_TRIAGE_TARGET_DURATION=45
AUTOMATION_TRIAGE_AFTER_IMPORT=true
AUTOMATION_TRIAGE_IMPORT_DELAY_SECONDS=30
AUTOMATION_AUTO_GREENLIGHT_MIN=85
AUTOMATION_REVIEW_BAND_MIN=60
AUTOMATION_VELOCITY_WINDOW_HOURS=12
AUTOMATION_VELOCITY_TARGET_SOURCES=5
AUTOMATION_COVERAGE_SIMILARITY=0.35
AUTOMATION_RECENCY_HALF_LIFE_HOURS=24
AUTOMATION_NOVELTY_WINDOW_DAYS=7
AUTOMATION_CLUSTER_SIMILARITY=0.35
AUTOMATION_CLUSTER_WINDOW_HOURS=48
AUTOMATION_CLUSTER_CANDIDATE_LIMIT=200
AUTOMATION_CLUSTER_MIN_SOURCES=3
AUTOMATION_CLUSTER_MAX_SOURCES=5
AUTOMATION_SCRIPT_AGENTS_ENABLED=false
AUTOMATION_SCRIPT_AGENTS_FEATURE_FLAG=script_agents.enabled
AUTOMATION_SCRIPT_AGENTS_USE_AI=false
AUTOMATION_SCRIPT_AGENTS_LANGUAGE=en
AUTOMATION_SCRIPT_AGENTS_TARGET_DURATION=45
AUTOMATION_SCRIPT_AGENTS_DURATION_TOLERANCE=5
AUTOMATION_SCRIPT_AGENTS_HOOK_WORD_LIMIT=12
AUTOMATION_SCRIPT_AGENTS_MAX_SCENE_SECONDS=12
AUTOMATION_SCRIPT_AGENTS_CLAIM_COVERAGE=0.30
AUTOMATION_SCRIPT_AGENTS_EVIDENCE_CHARS=300
AUTOMATION_SCRIPT_AGENTS_CALL_MICROS=10000
AUTOMATION_SCRIPT_AGENTS_MAX_TOKENS=1200
AUTOMATION_SCRIPT_AGENTS_TEMPERATURE=0.2
AUTOMATION_SCRIPT_AGENTS_MODEL=
AUTOMATION_SCRIPT_AGENTS_PROMPT_VERSION=g03-v1
AUTOMATION_CAPTIONS_ENABLED=false
AUTOMATION_CAPTIONS_FEATURE_FLAG=captions.enabled
AUTOMATION_ASSETS_ENABLED=false
AUTOMATION_ASSETS_FEATURE_FLAG=assets.enabled
AUTOMATION_FORMATS_ENABLED=false
AUTOMATION_FORMATS_FEATURE_FLAG=formats.enabled
AUTOMATION_PUBLISHING_ENABLED=false
AUTOMATION_PUBLISHING_FEATURE_FLAG=publishing.enabled
AUTOMATION_RENDER_PARALLEL=1
AUTOMATION_RENDER_DRIVER=remotion
AUTOMATION_HYPERFRAMES_ENABLED=false
AUTOMATION_HYPERFRAMES_FEATURE_FLAG=render.hyperframes
AUTOMATION_HYPERFRAMES_DIRECTORY=
AUTOMATION_HYPERFRAMES_OUTPUT_DIR=
AUTOMATION_HYPERFRAMES_OUTPUT_VIDEO_DIR=
AUTOMATION_HYPERFRAMES_CLI=
AUTOMATION_HYPERFRAMES_NODE_BINARY=node
# HyperFrames needs a full FFmpeg build (setparams filter). Remotion's bundled
# FFmpeg is stripped; leave empty to auto-detect a system/WinGet install.
AUTOMATION_HYPERFRAMES_FFMPEG_PATH=
AUTOMATION_HYPERFRAMES_TIMEOUT=600
AUTOMATION_HYPERFRAMES_QUALITY=looks
AUTOMATION_HYPERFRAMES_FPS=30
AUTOMATION_HYPERFRAMES_AUDIO_TTS_PROVIDER=auto
AUTOMATION_HYPERFRAMES_AUDIO_TARGET_LUFS=-14
AUTOMATION_HYPERFRAMES_AUDIO_TRUE_PEAK=-1.5
AUTOMATION_HYPERFRAMES_AUDIO_MAX_SILENCE_GAP=0.7
AUTOMATION_HYPERFRAMES_AUDIO_SAPI_RATE=1
AUTOMATION_HYPERFRAMES_AUDIO_WHISPER_MODEL=small
AUTOMATION_HYPERFRAMES_QA_LOUDNESS_TARGET=-14
AUTOMATION_HYPERFRAMES_QA_TRUE_PEAK_TARGET=-1
AUTOMATION_HYPERFRAMES_QA_SYNC_MS=80
AUTOMATION_HYPERFRAMES_QA_MAX_FIX=3
AUTOMATION_HYPERFRAMES_AGENT_ENABLED=false
AUTOMATION_HYPERFRAMES_AGENT_FEATURE_FLAG=render.hyperframes.agent
AUTOMATION_HYPERFRAMES_AGENT_USE_AI=false
AUTOMATION_HYPERFRAMES_AGENT_COPILOT_REVIEWED=false
AUTOMATION_HYPERFRAMES_AGENT_MODEL=
AUTOMATION_HYPERFRAMES_AGENT_TEMPERATURE=0.2
AUTOMATION_HYPERFRAMES_AGENT_MAX_TOKENS=4000
AUTOMATION_HYPERFRAMES_AGENT_CALL_MICROS=20000
